[importlinter]
root_packages =
    src
include_external_packages = True

# --- Rule 2: the module is a layered slice. Imports only ever point downward. ---
# `service` sits at the bottom because it is a pure contract: the router calls
# it and `internal` implements it, so both depend on it and it depends on
# nothing. That is dependency inversion, and it is what lets the SSE tests
# double the service without a database.
[importlinter:contract:resume-parsing-layers]
name = resume_parsing is layered: router -> dependencies -> internal -> service
type = layers
layers =
    src.resume_parsing.router
    src.resume_parsing.dependencies
    src.resume_parsing.internal
    src.resume_parsing.service
exhaustive = False

# --- Rule 3: routers never reach the database. ---
[importlinter:contract:router-has-no-db]
name = resume_parsing.router must not touch persistence
type = forbidden
# Only direct imports are violations: `dependencies` is the composition root and
# is *supposed* to reach into internal/, so every chain through it is expected.
allow_indirect_imports = True
source_modules =
    src.resume_parsing.router
forbidden_modules =
    sqlalchemy
    asyncpg
    src.core.db
    src.resume_parsing.internal

# --- Rule 1: internals are private to the module. ---
[importlinter:contract:internals-are-private]
name = resume_parsing.internal is private to the module
type = forbidden
# Only direct imports are violations: `dependencies` is the composition root and
# is *supposed* to reach into internal/, so every chain through it is expected.
allow_indirect_imports = True
source_modules =
    src.app
    src.core
    src.career_recommendation
forbidden_modules =
    src.resume_parsing.internal

# --- Module isolation: resume_parsing is self-contained. ---
[importlinter:contract:module-isolation]
name = resume_parsing does not depend on other feature modules
type = forbidden
# Only direct imports are violations: `dependencies` is the composition root and
# is *supposed* to reach into internal/, so every chain through it is expected.
allow_indirect_imports = True
source_modules =
    src.resume_parsing
forbidden_modules =
    src.career_recommendation

# --- Only the repository executes SQL. ---
[importlinter:contract:sql-lives-in-the-repository]
name = only internal.repository and internal.models may import sqlalchemy
type = forbidden
# Only direct imports are violations: `dependencies` is the composition root and
# is *supposed* to reach into internal/, so every chain through it is expected.
allow_indirect_imports = True
source_modules =
    src.resume_parsing.service
    src.resume_parsing.schemas
    src.resume_parsing.errors
    src.resume_parsing.internal.service_impl
    src.resume_parsing.internal.domain
    src.resume_parsing.internal.crypto
    src.resume_parsing.internal.pipeline
    src.resume_parsing.internal.providers
forbidden_modules =
    sqlalchemy
    asyncpg
