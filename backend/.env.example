# --- database (docker compose up -d brings this up) ---
DATABASE_URL=postgresql+asyncpg://dsai:dsai@localhost:5432/dsai
DB_ECHO=false

# --- field-level encryption at rest for candidate profiles ---
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PROFILE_ENCRYPTION_KEY=

# --- Google AI Studio (resume parsing) ---
# https://aistudio.google.com/apikey
# Shared by reporting, career recommendation, job discovery, and resume parsing.
GOOGLE_API_KEY=
# Legacy alias. Used only when GOOGLE_API_KEY is empty.
GOOGLE_AI_STUDIO_API_KEY=

# --- Supabase HTTP/RPC access ---
# These access the same PostgreSQL database configured by DATABASE_URL and are
# required by the current vector-search client during resume-to-report runs.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Primary parser. Set to the exact Gemma model id your AI Studio project exposes.
RESUME_PRIMARY_MODEL=gemini-3.5-flash
# Repair path. Invoked only when the primary output fails validation.
RESUME_FALLBACK_MODEL=gemini-2.5-flash
# `direct_vision` sends scanned pages to the model as images.
# `docling_text` runs local Docling OCR/layout extraction first.
RESUME_SCANNED_PDF_STRATEGY=direct_vision
# Docker build only: leave false for the smaller final image. Set true only
# together with RESUME_SCANNED_PDF_STRATEGY=docling_text.
ENABLE_DOCLING=false
# --- dev auth (replaced by Google SSO later) ---
DEV_USER_ID=dev-user
DEV_USER_EMAIL=dev@example.com

# --- limits ---
RESUME_MAX_UPLOAD_BYTES=10485760
RESUME_MAX_PAGES=10
RESUME_RENDER_DPI=150
